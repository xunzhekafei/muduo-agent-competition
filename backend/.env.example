# ============================================================
# 木铎笔记 (Muduo Notes) 环境变量模板
# ============================================================
# 复制此文件为 .env 并填入你的真实配置
#   cp .env.example .env
# ============================================================

# 通义千问 DashScope API Key（必填）
# 获取地址: https://www.alibabacloud.com/help/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=sk-your-api-key-here

# 上传文件临时目录（可选，默认 backend/temp_uploads）
# MUDUO_UPLOAD_DIR=./temp_uploads
