MUDUO_APP_NAME=Muduo API
MUDUO_APP_VERSION=0.1.0
MUDUO_ENVIRONMENT=development
MUDUO_DEBUG=false
MUDUO_LOG_LEVEL=INFO
MUDUO_API_V1_PREFIX=/api/v1
MUDUO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MUDUO_DATABASE_URL=sqlite+pysqlite:///./muduo_dev.sqlite3
MUDUO_DATABASE_ECHO=false
MUDUO_AUTH_SECRET_KEY=muduo-dev-secret-change-me
MUDUO_ACCESS_TOKEN_EXPIRES_MINUTES=30
MUDUO_REFRESH_TOKEN_EXPIRES_DAYS=14

# Development-only bootstrap user. Used only in development when this email logs in
# and the user does not already exist.
MUDUO_DEV_USER_EMAIL=dev@muduo.local
MUDUO_DEV_USER_PASSWORD=muduo123456
MUDUO_DEV_USER_NAME=Muduo Dev User

# External service provider adapters. MVP defaults use local mock providers.
MUDUO_LLM_PROVIDER=mock
MUDUO_OCR_PROVIDER=mock
MUDUO_ASR_PROVIDER=mock
MUDUO_EMBEDDING_PROVIDER=mock
MUDUO_OBJECT_STORAGE_PROVIDER=mock

# Local backend startup defaults. Uvicorn reads these only if scripts use them.
MUDUO_BACKEND_HOST=0.0.0.0
MUDUO_BACKEND_PORT=8000

# 设为 true 时，运行 scripts/reset_memory_demo.py 会重置记忆库演示数据。
# 默认 false，生产环境务必保持 false。
MUDUO_RESET_MEMORY_DEMO=false
